# Port exposed on the Docker host
THREAD_DASHBOARD_PORT=8888

# Address inside the container/service. For host networking use :8888.
LISTEN_ADDR=:8888

# OTBR REST endpoint. Home Assistant OTBR integration commonly uses port 8981.
OTBR_REST_URL=http://127.0.0.1:8981

# Existing OTBR container name. Used for docker exec ot-ctl commands.
OTBR_CONTAINER=otbr

# Host path to Home Assistant .storage. Optional but enables Matter-friendly names.
HA_STORAGE_HOST=/path/to/homeassistant/.storage
HA_STORAGE=/ha-storage

# Host path to python-matter-server data. Optional; enables observed links and diagnostics inference.
MATTER_DATA_HOST=/path/to/python-matter-server/data
MATTER_DATA=/matter-data
MATTER_WS_URL=ws://127.0.0.1:5580/ws
MATTER_IP_TTL=10m

# Retain routers and topology links when OTBR misses a poll.
TOPOLOGY_NODE_TTL=90s
TOPOLOGY_LINK_TTL=5m

# Alias file inside the container. Edit ./config/aliases.json on the host.
ALIAS_FILE=/config/aliases.json

# Backend polling interval. Values below 2s are clamped.
POLL_INTERVAL=10s

# Slow lane for topology, SRP, router table, and Matter diagnostics.
SLOW_POLL_INTERVAL=60s

# Poll cadence when no browser is connected to the live stream.
IDLE_POLL_INTERVAL=60s

# Cache disk-backed metadata between refreshes.
METADATA_CACHE_TTL=30s

# Cache OTBR REST /node metadata briefly.
NODE_CACHE_TTL=30s

# Include raw ot-ctl output in API snapshots. Enable only while debugging.
INCLUDE_RAW=false

# Include full parsed counter maps in snapshots. Summary counters are always included.
INCLUDE_COUNTERS=false

# Collect OTBR RX/TX history. Disable for the lightest topology-only mode.
ENABLE_TRAFFIC=true

# Log refresh timing periodically and whenever a refresh is slow.
LOG_REFRESH_TIMING=true

# Browser-side traffic event retention.
TRAFFIC_HISTORY_LIMIT=2000

# Go runtime memory tuning.
GOGC=50
GOMEMLIMIT=64MiB
